{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "mcp__apify__call-actor",
      "mcp__claude_ai_Google_Drive__create_file",
      "mcp__chrome-devtools-mcp__take_snapshot",
      "mcp__chrome-devtools-mcp__list_pages",
      "mcp__chrome-devtools-mcp__select_page",
      "WebSearch",
      "mcp__chrome-devtools-mcp__navigate_page",
      "mcp__claude_ai_Learnn__get_lesson",
      "mcp__chrome-devtools-mcp__close_page",
      "mcp__apify__apify--web-fetch"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__chrome-devtools-mcp__navigate_page|mcp__chrome-devtools-mcp__new_page|mcp__chrome-devtools-mcp__list_pages|mcp__chrome-devtools-mcp__take_screenshot",
        "hooks": [
          {
            "type": "command",
            "command": "$port = \"$env:LOCALAPPDATA\\Google\\Chrome\\User Data\\DevToolsActivePort\"; if (-not (Test-Path $port)) { $chrome = 'C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe'; if (-not (Test-Path $chrome)) { $chrome = 'C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe' }; Start-Process $chrome -ArgumentList '--remote-debugging-port=9222'; Start-Sleep -Seconds 3 }",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "Avvio Chrome con remote debugging..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "parallel@parallel-agent-skills": true
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "stefano1479.app.n8n.cloud"
      ]
    }
  },
  "autoUpdatesChannel": "latest",
  "agentPushNotifEnabled": true,
  "effortLevel": "high",
  "skillOverrides": {
    "pm-data-analytics-ab-test-analysis": "off",
