# Credenziali — MAI nel repo
.credentials.json
backups/

# Config locale (permessi, MCP abilitati)
# Il glob copre anche backup e varianti: settings.local.json contiene chiavi API,
# la regola esatta non bastava (es. settings.local.json.doctor-backup passava).
settings.local.json*

# Backup di configurazione generati localmente
*.doctor-backup
*.bak

# Sessioni e storia
history.jsonl
projects/
sessions/
file-history/
shell-snapshots/

# Cache ed effimeri
cache/
debug/
paste-cache/
ide/
tasks/
telemetry/
todos/
plans/
downloads/
plugins/

# Stats e cache runtime
stats-cache.json
mcp-needs-auth-cache.json
.last-cleanup

# Cartelle locali che un "git add -A" pubblicherebbe per sbaglio
# scheduled-tasks: prompt dei task pianificati, possono contenere riferimenti privati
# skills/.trash e skills/synced: copie di lavoro generate dall'app, non le skill vere
# chrome e state: file specifici di questa macchina
scheduled-tasks/
skills/.trash/
skills/synced/
chrome/
state/

# OS e editor
.DS_Store
Thumbs.db
